{
  "compileOnSave": true,
  "include": [
    "src"
  ],
  "compilerOptions": {
    "module": "NodeNext",
    "noImplicitReturns": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noUnusedLocals": true,
    "baseUrl": ".", // Set base URL to resolve paths
    "paths": {
      "@server": ["../server"], // Map @server to the parent server directory
      "@shared/*": ["../shared/*"]
    }
  }
}