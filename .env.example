# Database Configuration
DATABASE_URL=postgresql://your-dev-database-url

# Production Database (for syncing data to dev)
# Get this from your Neon dashboard for the production database
# IMPORTANT: Only add this in development, never commit with real values!
PRODUCTION_DATABASE_URL=postgresql://your-production-database-url

# Session Secret
SESSION_SECRET=your-session-secret-here

# AWS S3 Configuration (for product images)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1

# Object Storage
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
PUBLIC_OBJECT_SEARCH_PATHS=public
PRIVATE_OBJECT_DIR=.private

# AI API Keys
OPENAI_API_KEY=your-openai-api-key
STABILITY_API_KEY=your-stability-api-key

# Optional: Replicate for additional AI models
# REPLICATE_API_TOKEN=your-replicate-token