{
  "emulators": {
    "hub": {
      "host": "0.0.0.0",
      "port": 9100
    },
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData",
      "host": "0.0.0.0",
      "port": 9104
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 9103,
      "rules": "firestore.rules"
    },
    "functions": {
      "host": "0.0.0.0",
      "port": 9105
    },
    "ui": {
      "host": "0.0.0.0",
      "port": 9101
    },
    "logging": {
      "host": "0.0.0.0",
      "port": 9102
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "server/functions",
      "codebase": "curalina-ai",
      "secretEnvironment": ["DATABASE_URL"]
    }
  ],
  "hosting": {
    "public": "dist/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "codebase": "curalina-ai",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}