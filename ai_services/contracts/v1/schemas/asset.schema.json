{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curalina.local/contracts/v1/asset.schema.json",
  "title": "Asset",
  "description": "Public view of an Asset record. Storage keys are internal and never serialized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "content_hash",
    "media_type",
    "width_px",
    "height_px",
    "owner_id",
    "provenance",
    "original_filename",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "asset_id": { "type": "string", "pattern": "^asset_" },
    "upstream_asset_id": { "type": ["string", "null"] },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "media_type": { "type": "string" },
    "width_px": { "type": "integer", "exclusiveMinimum": 0 },
    "height_px": { "type": "integer", "exclusiveMinimum": 0 },
    "owner_id": { "type": "string", "minLength": 1 },
    "provenance": { "type": "string", "minLength": 1 },
    "original_filename": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
