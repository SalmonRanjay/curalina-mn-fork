{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curalina.local/contracts/v1/error.schema.json",
  "title": "CuralinaError",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "details", "retryable", "request_id"],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object"
    },
    "retryable": {
      "type": "boolean"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
